{
  "name": "session-dashboard",
  "displayName": "AI Session Dashboard",
  "description": "Zeigt alle laufenden Claude-Code- und Antigravity-Sessions mit Zustand: wartet, arbeitet, fertig, erledigt.",
  "version": "0.8.1",
  "publisher": "schueri",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionDashboard",
          "title": "AI Sessions",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sessionDashboard": [
        {
          "id": "sessionDashboard.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionDashboard.filter",
        "title": "Filter nach Provider...",
        "category": "Session Dashboard",
        "icon": "$(filter)"
      },
      {
        "command": "sessionDashboard.open",
        "title": "Chat öffnen",
        "category": "Session Dashboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sessionDashboard.bookmark",
        "title": "Session merken",
        "category": "Session Dashboard",
        "icon": "$(pin)"
      },
      {
        "command": "sessionDashboard.unbookmark",
        "title": "Nicht mehr merken",
        "category": "Session Dashboard",
        "icon": "$(pinned)"
      },
      {
        "command": "sessionDashboard.unbookmarkAll",
        "title": "Alle gemerkten freigeben",
        "category": "Session Dashboard",
        "icon": "$(check-all)"
      },
      {
        "command": "sessionDashboard.markDone",
        "title": "Als erledigt markieren",
        "category": "Session Dashboard",
        "icon": "$(check)"
      },
      {
        "command": "sessionDashboard.unmarkDone",
        "title": "Wieder aktiv",
        "category": "Session Dashboard",
        "icon": "$(discard)"
      },
      {
        "command": "sessionDashboard.showBoard",
        "title": "Übersicht öffnen",
        "category": "Session Dashboard",
        "icon": "$(layout)"
      },
      {
        "command": "sessionDashboard.search",
        "title": "Session suchen...",
        "category": "Session Dashboard",
        "icon": "$(search)"
      },
      {
        "command": "sessionDashboard.refresh",
        "title": "Aktualisieren",
        "category": "Session Dashboard",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionDashboard.filter",
          "when": "view == sessionDashboard.sessions",
          "group": "navigation@1"
        },
        {
          "command": "sessionDashboard.search",
          "when": "view == sessionDashboard.sessions",
          "group": "navigation@1.5"
        },
        {
          "command": "sessionDashboard.showBoard",
          "when": "view == sessionDashboard.sessions",
          "group": "navigation@2"
        },
        {
          "command": "sessionDashboard.refresh",
          "when": "view == sessionDashboard.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionDashboard.bookmark",
          "when": "view == sessionDashboard.sessions && (viewItem == session || viewItem == session-done)",
          "group": "inline@1"
        },
        {
          "command": "sessionDashboard.unbookmark",
          "when": "view == sessionDashboard.sessions && (viewItem == session-bookmarked || viewItem == session-done-bookmarked)",
          "group": "inline@1"
        },
        {
          "command": "sessionDashboard.markDone",
          "when": "view == sessionDashboard.sessions && (viewItem == session || viewItem == session-bookmarked)",
          "group": "inline@2"
        },
        {
          "command": "sessionDashboard.unmarkDone",
          "when": "view == sessionDashboard.sessions && (viewItem == session-done || viewItem == session-done-bookmarked)",
          "group": "inline@2"
        },
        {
          "command": "sessionDashboard.unbookmarkAll",
          "when": "view == sessionDashboard.sessions && viewItem == group-bookmarked",
          "group": "inline"
        },
        {
          "command": "sessionDashboard.open",
          "when": "view == sessionDashboard.sessions && viewItem =~ /^session/",
          "group": "1_open"
        }
      ],
      "commandPalette": [
        {
          "command": "sessionDashboard.open",
          "when": "false"
        },
        {
          "command": "sessionDashboard.bookmark",
          "when": "false"
        },
        {
          "command": "sessionDashboard.unbookmark",
          "when": "false"
        },
        {
          "command": "sessionDashboard.unbookmarkAll",
          "when": "false"
        },
        {
          "command": "sessionDashboard.markDone",
          "when": "false"
        },
        {
          "command": "sessionDashboard.unmarkDone",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check lib/registry.js && node --check lib/providers/claude.js && node --check lib/providers/antigravity.js && node --check lib/transcripts.js && node --check lib/history.js && node --check lib/doneStore.js && node --check lib/bookmarkStore.js && node --check lib/treeView.js && node --check lib/boardPanel.js && node --check lib/format.js",
    "package": "vsce package --skip-license --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
