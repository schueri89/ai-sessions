{
  "name": "ai-sessions",
  "displayName": "AI Sessions",
  "description": "Zeigt alle laufenden Claude-Code-, Antigravity-, GitHub-Copilot-, OpenAI-Codex- und Cline-Sessions mit Zustand: wartet, arbeitet, fertig, erledigt.",
  "version": "0.57.1",
  "publisher": "schueri",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:sessionDashboard.board"
  ],
  "contributes": {
    "icons": {
      "dashboard-claude": {
        "description": "Claude Code",
        "default": {
          "fontPath": "./resources/icons.woff",
          "fontCharacter": "\\ea02"
        }
      },
      "dashboard-antigravity": {
        "description": "Google Antigravity",
        "default": {
          "fontPath": "./resources/icons.woff",
          "fontCharacter": "\\ea01"
        }
      },
      "dashboard-codex": {
        "description": "OpenAI Codex",
        "default": {
          "fontPath": "./resources/icons.woff",
          "fontCharacter": "\\ea03"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionDashboard",
          "title": "AI Sessions",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sessionDashboard": [
        {
          "id": "sessionDashboard.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionDashboard.filter",
        "title": "Filter nach Provider...",
        "category": "Session Dashboard",
        "icon": "$(filter)"
      },
      {
        "command": "sessionDashboard.filterProject",
        "title": "Filter nach Projekt...",
        "category": "Session Dashboard",
        "icon": "$(folder)"
      },
      {
        "command": "sessionDashboard.open",
        "title": "Chat öffnen",
        "category": "Session Dashboard",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sessionDashboard.bookmark",
        "title": "Session merken",
        "category": "Session Dashboard",
        "icon": "$(pin)"
      },
      {
        "command": "sessionDashboard.unbookmark",
        "title": "Nicht mehr merken",
        "category": "Session Dashboard",
        "icon": "$(pinned)"
      },
      {
        "command": "sessionDashboard.unbookmarkAll",
        "title": "Alle gemerkten freigeben",
        "category": "Session Dashboard",
        "icon": "$(check-all)"
      },
      {
        "command": "sessionDashboard.markDone",
        "title": "Als erledigt markieren",
        "category": "Session Dashboard",
        "icon": "$(check)"
      },
      {
        "command": "sessionDashboard.markAllDone",
        "title": "Alles als erledigt markieren",
        "category": "Session Dashboard",
        "icon": "$(check-all)"
      },
      {
        "command": "sessionDashboard.unmarkDone",
        "title": "Wieder aktiv",
        "category": "Session Dashboard",
        "icon": "$(discard)"
      },
      {
        "command": "sessionDashboard.showBoard",
        "title": "Übersicht öffnen",
        "category": "Session Dashboard",
        "icon": "$(layout)"
      },
      {
        "command": "sessionDashboard.showAnalyse",
        "title": "Analyse & Verbrauch öffnen",
        "category": "Session Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "sessionDashboard.showHistory",
        "title": "Session-Historie öffnen (Tabelle)",
        "category": "Session Dashboard",
        "icon": "$(table)"
      },
      {
        "command": "sessionDashboard.search",
        "title": "Session suchen...",
        "category": "Session Dashboard",
        "icon": "$(search)"
      },
      {
        "command": "sessionDashboard.quickMenu",
        "title": "Schnellmenü öffnen (Direktzugriff)",
        "category": "Session Dashboard",
        "icon": "$(zap)"
      },
      {
        "command": "sessionDashboard.copilotSignIn",
        "title": "GitHub Copilot: Zugriff freigeben / Anmelden",
        "category": "Session Dashboard",
        "icon": "$(copilot)"
      },
      {
        "command": "sessionDashboard.statusBarClick",
        "title": "Statusleiste: Aktion ausführen",
        "category": "Session Dashboard"
      },
      {
        "command": "sessionDashboard.claudeStatusClick",
        "title": "Claude-Code-Sessions anzeigen",
        "category": "Session Dashboard"
      },
      {
        "command": "sessionDashboard.antigravityStatusClick",
        "title": "Google-Antigravity-Sessions anzeigen",
        "category": "Session Dashboard"
      },
      {
        "command": "sessionDashboard.codexStatusClick",
        "title": "OpenAI-Codex-Sessions anzeigen",
        "category": "Session Dashboard"
      },
      {
        "command": "sessionDashboard.copilotStatusClick",
        "title": "GitHub-Copilot-Sessions anzeigen",
        "category": "Session Dashboard"
      },
      {
        "command": "sessionDashboard.refresh",
        "title": "Aktualisieren",
        "category": "Session Dashboard",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionDashboard.viewTranscript",
        "title": "Transkript ansehen (Read-Only)",
        "category": "Session Dashboard",
        "icon": "$(book)"
      },
      {
        "command": "sessionDashboard.showDebugLog",
        "title": "Debug-Log anzeigen",
        "category": "Session Dashboard",
        "icon": "$(output)"
      },
      {
        "command": "sessionDashboard.toggleSound",
        "title": "Sounds ein-/ausschalten",
        "category": "Session Dashboard",
        "icon": "$(unmute)"
      },
      {
        "command": "sessionDashboard.toggleNotifications",
        "title": "Benachrichtigungen ein-/ausschalten",
        "category": "Session Dashboard",
        "icon": "$(bell)"
      },
      {
        "command": "sessionDashboard.previewSound",
        "title": "Sound vorhören...",
        "category": "Session Dashboard",
        "icon": "$(megaphone)"
      },
      {
        "command": "sessionDashboard.openSettings",
        "title": "Einstellungen öffnen",
        "category": "Session Dashboard",
        "icon": "$(gear)"
      },
      {
        "command": "sessionDashboard.assignTicket",
        "title": "JIRA-Ticket zuweisen...",
        "category": "Session Dashboard",
        "icon": "$(tag)"
      },
      {
        "command": "sessionDashboard.openJira",
        "title": "JIRA-Ticket im Browser öffnen",
        "category": "Session Dashboard",
        "icon": "$(link-external)"
      },
      {
        "command": "sessionDashboard.assignProject",
        "title": "Projekt manuell zuweisen...",
        "category": "Session Dashboard",
        "icon": "$(folder)"
			},
			{
				"command": "sessionDashboard.showJenkins",
				"title": "Jenkins Deploy-Jobs anzeigen",
				"category": "Session Dashboard",
				"icon": "$(rocket)"
			},
			{
				"command": "sessionDashboard.jenkinsSetCredentials",
				"title": "Jenkins-Zugangsdaten hinterlegen...",
				"category": "Session Dashboard",
				"icon": "$(key)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionDashboard.filter",
          "when": "view == sessionDashboard.sessions",
          "group": "navigation@1"
        },
        {
          "command": "sessionDashboard.filterProject",
          "when": "view == sessionDashboard.sessions",
          "group": "navigation@1.2"
        },
        {
          "command": "sessionDashboard.search",
          "when": "view == sessionDashboard.sessions",
          "group": "navigation@1.5"
        },
        {
          "command": "sessionDashboard.showBoard",
          "when": "view == sessionDashboard.sessions",
          "group": "navigation@2"
        },
        {
          "command": "sessionDashboard.refresh",
          "when": "view == sessionDashboard.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionDashboard.bookmark",
          "when": "view == sessionDashboard.sessions && (viewItem == session || viewItem == session-done)",
          "group": "inline@1"
        },
        {
          "command": "sessionDashboard.unbookmark",
          "when": "view == sessionDashboard.sessions && (viewItem == session-bookmarked || viewItem == session-done-bookmarked)",
          "group": "inline@1"
        },
        {
          "command": "sessionDashboard.markDone",
          "when": "view == sessionDashboard.sessions && (viewItem == session || viewItem == session-bookmarked)",
          "group": "inline@2"
        },
        {
          "command": "sessionDashboard.unmarkDone",
          "when": "view == sessionDashboard.sessions && (viewItem == session-done || viewItem == session-done-bookmarked)",
          "group": "inline@2"
        },
        {
          "command": "sessionDashboard.unbookmarkAll",
          "when": "view == sessionDashboard.sessions && viewItem == group-bookmarked",
          "group": "inline"
        },
        {
          "command": "sessionDashboard.open",
          "when": "view == sessionDashboard.sessions && viewItem =~ /^session/",
          "group": "1_open"
        },
        {
          "command": "sessionDashboard.viewTranscript",
          "when": "view == sessionDashboard.sessions && viewItem =~ /^session/",
          "group": "2_view"
        }
      ],
      "commandPalette": [
        {
          "command": "sessionDashboard.open",
          "when": "false"
        },
        {
          "command": "sessionDashboard.bookmark",
          "when": "false"
        },
        {
          "command": "sessionDashboard.unbookmark",
          "when": "false"
        },
        {
          "command": "sessionDashboard.unbookmarkAll",
          "when": "false"
        },
        {
          "command": "sessionDashboard.markDone",
          "when": "false"
        },
        {
          "command": "sessionDashboard.markAllDone",
          "when": "false"
        },
        {
          "command": "sessionDashboard.unmarkDone",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Session Dashboard",
      "properties": {
        "sessionDashboard.statusBarClickAction": {
          "type": "string",
          "enum": [
            "board",
            "quickpick",
            "firstWaiting"
          ],
          "enumDescriptions": [
            "Öffnet die Dashboard-Übersicht (Standard)",
            "Öffnet das Schnellmenü mit direktem Zugriff",
            "Öffnet direkt die erste wartende Session"
          ],
          "default": "board",
          "description": "Aktion beim Klick auf das Statusleisten-Widget."
        },
        "sessionDashboard.autoPinTab": {
          "type": "boolean",
          "default": true,
          "description": "Dashboard-Tab beim Öffnen automatisch anpinnen."
        },
        "sessionDashboard.showLastPrompt": {
          "type": "boolean",
          "default": false,
          "description": "Letzten Benutzer-Prompt auf den Dashboard-Kacheln anzeigen (Standard: deaktiviert für kompaktere Kacheln)."
        },
        "sessionDashboard.openOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Dashboard beim Starten von VS Code automatisch im Editor öffnen."
        },
        "sessionDashboard.statusBarUsage": {
          "type": "string",
          "enum": [
            "compact",
            "text",
            "5h",
            "both",
            "detailed",
            "off"
          ],
          "enumDescriptions": [
            "Icons kompakt: $(dashboard-claude) X% · $(dashboard-antigravity) Y% · $(dashboard-codex) Z% · $(copilot) M% (Standard)",
            "Text kompakt: Claude: X% · AG: Y% · Codex: Z% · Copilot: M%",
            "Kurzzeit-Fenster beschriftet: $(dashboard-claude) X% (5h) · $(dashboard-antigravity) Y% (5h) · $(dashboard-codex) Z% (5h) · $(copilot) M% (Monat)",
            "5h & 7d / Monat & Budget kombiniert: $(dashboard-claude) X%/Y% · $(dashboard-antigravity) A%/B%[/C%] · $(dashboard-codex) C%/D% · $(copilot) M%/B%",
            "Ausführlich mit Beschriftung: $(dashboard-claude) X% (5h) · Y% (7d) · $(dashboard-antigravity) A% (5h) · B% (7d) · $(dashboard-codex) C% (5h) · D% (7d) · $(copilot) M% (Monat) · B% (Budget)",
            "Usage in Statusleiste ausblenden (nur beim Hover)"
          ],
          "default": "compact",
          "description": "Format der getrennten Quota-/Limit-Verbrauchsanzeige in der Statusleiste (Footerbar)."
        },
        "sessionDashboard.quotaWarningThreshold": {
          "type": "number",
          "default": 75,
          "minimum": 1,
          "maximum": 100,
          "description": "Auslastungsschwelle in Prozent, ab der das Statusleisten-Icon gelb hinterlegt wird (Warnung)."
        },
        "sessionDashboard.quotaErrorThreshold": {
          "type": "number",
          "default": 95,
          "minimum": 1,
          "maximum": 100,
          "description": "Auslastungsschwelle in Prozent, ab der das Statusleisten-Icon rot hinterlegt wird (Kritisch/Limit)."
        },
        "sessionDashboard.providers.claude": {
          "type": "boolean",
          "default": true,
          "description": "Claude-Code-Sessions erfassen und anzeigen."
        },
        "sessionDashboard.providers.antigravity": {
          "type": "boolean",
          "default": true,
          "description": "Google-Antigravity-Sessions erfassen und anzeigen."
        },
        "sessionDashboard.providers.copilot": {
          "type": "boolean",
          "default": true,
          "description": "GitHub-Copilot-Sessions erfassen und anzeigen."
        },
        "sessionDashboard.providers.codex": {
          "type": "boolean",
          "default": true,
          "description": "OpenAI-Codex-Sessions erfassen und anzeigen."
        },
        "sessionDashboard.providers.cline": {
          "type": "boolean",
          "default": true,
          "description": "Cline-Sessions erfassen und anzeigen."
        },
        "sessionDashboard.sound.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Akustische Benachrichtigungen für Session-Ereignisse aktivieren."
        },
        "sessionDashboard.sound.providers.claude": {
          "type": "boolean",
          "default": true,
          "description": "Sounds für Claude-Code-Sessions abspielen."
        },
        "sessionDashboard.sound.providers.antigravity": {
          "type": "boolean",
          "default": true,
